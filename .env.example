# Copy to .env and fill in at least one key. Gemini is primary; Groq is fallback.
# Get a free Gemini key at https://aistudio.google.com/apikey
# Do NOT enable billing on that Google Cloud project — it silently kills the free tier.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

# Mock supplier API (started automatically by start.py)
SUPPLIER_API_URL=http://127.0.0.1:8001

# Main app
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/orchestrai.db

# Slack incoming-webhook for approval notifications (optional).
# Get one at: Slack -> Your workspace -> Apps -> Incoming Webhooks -> Add New Webhook.
# Leave blank to disable (the demo works without it).
SLACK_WEBHOOK_URL=
